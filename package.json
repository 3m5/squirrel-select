{
  "name": "@3m5-de/squirrel-select",
  "version": "0.1.5",
  "description": "A stylesheet for the native <select>. No JavaScript.",
  "keywords": [
    "select",
    "css",
    "base-select",
    "customizable-select",
    "accessibility"
  ],
  "license": "MIT",
  "homepage": "https://3m5.github.io/squirrel-select/",
  "bugs": "https://github.com/3m5/squirrel-select/issues",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/3m5/squirrel-select.git"
  },
  "type": "module",
  "exports": {
    "./squirrel-select.css": "./dist/squirrel-select.css",
    "./package.json": "./package.json"
  },
  "files": [
    "dist"
  ],
  "sideEffects": [
    "*.css"
  ],
  "scripts": {
    "dev": "node scripts/dev.mjs",
    "build": "node scripts/build.mjs",
    "site": "npm run build && node scripts/site.mjs",
    "lint": "eslint scripts tests site/assets playwright.config.ts eslint.config.mjs stylelint.config.mjs && stylelint \"src/**/*.css\" \"site/assets/*.css\"",
    "typecheck": "tsc --noEmit",
    "size": "node scripts/size.mjs",
    "pack:check": "node scripts/pack-check.mjs",
    "test": "npm run lint && npm run typecheck && npm run site && npm run size && npm run pack:check",
    "test:browser": "playwright test",
    "test:browser:docker": "npm run site && docker run --rm --init --ipc=host -u \"$(id -u):$(id -g)\" -e HOME=/tmp -e CI -v \"$(pwd):/work\" -w /work mcr.microsoft.com/playwright:v$(node -p \"require('./node_modules/@playwright/test/package.json').version\")-noble npx playwright test",
    "test:browser:update": "npm run test:browser:docker -- --update-snapshots=changed"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.14.0",
    "@eslint/js": "^10.0.1",
    "@guidepup/guidepup": "0.40.0",
    "@guidepup/playwright": "0.21.0",
    "@guidepup/setup": "0.29.3",
    "@playwright/test": "1.65.1",
    "@types/node": "^26.6.6",
    "esbuild": "^0.28.2",
    "eslint": "^10.14.0",
    "globals": "^17.14.0",
    "marked": "^18.2.1",
    "stylelint": "^18.0.0",
    "stylelint-config-standard": "^41.0.0",
    "typescript": "~6.0.3",
    "typescript-eslint": "^8.72.2"
  }
}
